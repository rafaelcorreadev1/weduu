PORT=4000
PLATFORM_BASE_URL=https://dev-wdu-ped-test-1014944555984.us-central1.run.app
PLATFORM_TIMEOUT_MS=10000
LOG_LEVEL=info

# Protege as rotas /admin, que ficam expostas pelo túnel. Gere com:
# node -e "console.log(crypto.randomBytes(24).toString('hex'))"
ADMIN_KEY=

# URL pública do túnel (ex.: https://xxxx.ngrok.app), usada no registro
PUBLIC_URL=

CREDENTIALS_FILE=.credentials.json

# O /enrich responde 429 acima de 3 requisições em voo
ENRICH_MAX_CONCURRENCY=3
ENRICH_TIMEOUT_MS=3000
ENRICH_MAX_ATTEMPTS=5

# Sem mensagens novas e sem itens em processamento por esse tempo, envia o callback parcial
RUN_IDLE_TIMEOUT_MS=10000
# Opcional: sobrescrevem o .credentials.json
WEDUU_CID=
WEDUU_TOKEN=
